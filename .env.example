# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env`, and never paste the token into a chat window.
#
# This account (@claude.cheats) needs its OWN app + token in the Meta
# developer portal — it is a separate Instagram Business account from
# @lostempiresai, so it cannot reuse ig-publisher/.env.

# instagram = "Manage messaging and content on Instagram" use case.
#             Direct Instagram login, no Facebook Page needed. ← what we use
AUTH_MODE=instagram

# Your Instagram account ID (a long number, NOT your @handle).
# `node check.js` will print it for you once the token is set.
IG_USER_ID=

# Long-lived access token from the Meta developer portal (~60 day expiry).
IG_ACCESS_TOKEN=

# Graph API version. Bump if a call starts failing with a deprecation error —
# see developers.facebook.com/docs/graph-api/changelog
GRAPH_VERSION=v23.0
